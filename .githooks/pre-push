#!/bin/sh
# 拦住对**公开仓库**的直接推送，防止只该留在私有仓库的内容被推出去。
#
# 为什么需要它：两个远端装的不是同一份历史——
#   origin = Lumi-dev（私有）  本地历史原样备份：main、backup/pre-public、tag，什么都收
#   public = Lumi    （公开）  由 scripts/sync-public.sh 生成：整段历史去掉了
#                              AGENTS.md / CLAUDE.md，提交哈希和本地不同
# 直接 `git push public` 会把这两个文件连同本地历史一起带进公开仓库，而且推出去
# 就收不回来（别人 fetch 走的拿不回来）。`git push --all`、`git push --mirror`、
# 图形客户端的“推送所有分支”都会造成这种事故，而它们看起来都很无害。
#
# 规则（按 URL 判断，不看远端名）：
#   …/Lumi-dev                → 私有仓库，放行
#   …/Lumi、…/Lumi-history    → 公开仓库（后者是改名前的旧地址，GitHub 会重定向过去）：
#                               一律拒绝。sync-public.sh 从临时克隆推送，不经过这个钩子
#   其它（fork、自建远端）     → 放行：贡献者在自己的 fork 上推特性分支必须照常可用
#
# 确实需要绕过：git push --no-verify
# 同步公开仓库：scripts/sync-public.sh

remote_name="$1"
remote_url="$2"

dev_repo="tianruijia2008/Lumi-dev"        # 私有仓库（见 STRUCTURE.md 第 8 节）
public_repo="tianruijia2008/Lumi"        # 公开仓库
legacy_repo="tianruijia2008/Lumi-history" # 公开仓库改名前的地址

# 去掉结尾的 / 与 .git，再按结尾精确匹配——Lumi 是 Lumi-dev 的前缀，不能用“包含”判断
url="${remote_url%/}"
url="${url%.git}"

case "$url" in
    *"/$dev_repo" | *":$dev_repo")
        exit 0 ;;
    *"/$public_repo" | *":$public_repo" | *"/$legacy_repo" | *":$legacy_repo")
        echo "✗ 公开仓库「${remote_name}」（${remote_url}）不接受直接推送：" >&2
        echo "  它的历史是过滤后重新生成的（去掉了 AGENTS.md / CLAUDE.md），" >&2
        echo "  直接推会把这两个文件带进公开仓库。" >&2
        echo "  请用：scripts/sync-public.sh" >&2
        exit 1 ;;
    *)
        exit 0 ;;
esac
